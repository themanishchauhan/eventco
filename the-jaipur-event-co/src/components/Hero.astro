---
import { Image } from 'astro:assets';
import heroImage from '../assets/hero.jpg';

interface Props {
  headline?: string;
  subheadline?: string;
}
const { 
  headline = 'Crafting Timeless Celebrations in the Pink City',
  subheadline = "Jaipur's premier event design & management studio. Weddings • Corporate • Cultural"
} = Astro.props;
---

<section id="home" class="relative min-h-screen flex items-center justify-center overflow-hidden" aria-labelledby="hero-title">
  <div class="absolute inset-0 z-0">
    <Image src={heroImage} alt="" class="w-full h-full object-cover" priority loading="eager" fetchpriority="high" />
    <div class="absolute inset-0 bg-gradient-to-t from-terracotta-900/70 via-terracotta-900/20 to-transparent" aria-hidden="true"></div>
  </div>

  <div class="relative z-10 container-custom px-4 py-20">
    <div class="max-w-4xl mx-auto text-center animate-fade-in">
      <span class="inline-block px-4 py-1.5 rounded-full bg-gold-400/20 text-gold-700 text-sm font-medium mb-6 animate-slide-up">Featured in Jaipur's Finest Venues</span>
      
      <h1 id="hero-title" class="font-heading font-medium text-cream-50 text-4xl md:text-5xl lg:text-6xl xl:text-7xl leading-tight mb-6 animate-slide-up-delay-1">
        {headline}
      </h1>
      
      <p class="font-accent text-cream-200 text-lg md:text-xl lg:text-2xl max-w-3xl mx-auto mb-10 animate-slide-up-delay-2">
        {subheadline}
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-slide-up-delay-3">
        <a href="#gallery" class="btn-primary text-lg px-10 py-4">
          View Our Work
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a href="#contact" class="btn-secondary text-lg px-10 py-4 border-cream-200 text-cream-50 hover:bg-cream-50 hover:border-cream-300">
          Plan Your Event
        </a>
      </div>
    </div>

    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 animate-bounce" aria-hidden="true">
      <svg class="w-6 h-6 text-cream-300/70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </div>
  </div>
</section>