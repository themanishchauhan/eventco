---
import { getCollection } from 'astro:content';

type Category = 'weddings' | 'corporate' | 'decor' | 'cultural';

interface Props {
  title?: string;
  subtitle?: string;
}
const { 
  title = 'Our Work',
  subtitle = 'A curated collection of celebrations we\'ve had the honor to craft'
} = Astro.props;

const allImages = await getCollection('gallery');
const categories: Category[] = ['weddings', 'corporate', 'decor', 'cultural'];

const placeholderImages: Record<Category, string[]> = {
  weddings: [
    'https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=800&q=80',
    'https://images.unsplash.com/photo-1511285560929-80b456fea0bc?auto=format&fit=crop&w=800&q=80'
  ],
  corporate: [
    'https://images.unsplash.com/photo-1511578314322-379afb476865?auto=format&fit=crop&w=800&q=80',
    'https://images.unsplash.com/photo-1475721027785-f74eccf877e2?auto=format&fit=crop&w=800&q=80'
  ],
  decor: [
    'https://images.unsplash.com/photo-1465495976277-4387d4b0b4c6?auto=format&fit=crop&w=800&q=80',
    'https://images.unsplash.com/photo-1519225421980-715cb0215aed?auto=format&fit=crop&w=800&q=80'
  ],
  cultural: [
    'https://images.unsplash.com/photo-1532712938310-34cb3982ef74?auto=format&fit=crop&w=800&q=80'
  ]
};
---

<section id="gallery" class="section bg-white" aria-labelledby="gallery-title">
  <div class="container-custom">
    <div class="max-w-3xl mx-auto text-center mb-12">
      <span class="inline-block px-3 py-1 rounded-full bg-terracotta-100 text-terracotta-700 text-sm font-medium mb-4">Gallery</span>
      <h2 id="gallery-title" class="section-title">{title}</h2>
      <p class="section-subtitle mx-auto">{subtitle}</p>
    </div>

    <div class="flex flex-wrap justify-center gap-2 mb-10" role="tablist" aria-label="Gallery categories">
      <button 
        data-category="all" 
        class="category-btn px-5 py-2 rounded-full bg-terracotta-100 text-terracotta-700 text-sm font-medium transition-all duration-200"
        role="tab" 
        aria-selected="true"
        aria-controls="gallery-panel"
      >
        All
      </button>
      {categories.map(cat => (
        <button 
          data-category={cat} 
          class="category-btn px-5 py-2 rounded-full bg-cream-100 text-cream-700 text-sm font-medium transition-all duration-200 hover:bg-terracotta-50 hover:text-terracotta-700"
          role="tab" 
          aria-selected="false"
          aria-controls="gallery-panel"
        >
          {cat.charAt(0).toUpperCase() + cat.slice(1)}
        </button>
      ))}
    </div>

    <div id="gallery-panel" class="gallery-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4" role="tabpanel" aria-label="Gallery images">
      {allImages.sort((a, b) => a.data.order - b.data.order).map((item, i) => {
        const catList = placeholderImages[item.data.category as Category] || placeholderImages.weddings;
        const imgSrc = catList[i % catList.length];
        return (
          <article 
            class="gallery-item group" 
            data-category={item.data.category}
            style={`--order: ${i}`}
          >
            <img 
              src={imgSrc} 
              alt={item.data.title}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
            <div class="gallery-overlay">
              <div class="w-full">
                <span class="inline-block px-3 py-1 text-xs font-medium text-gold-300 bg-terracotta-900/90 rounded-full mb-2">
                  {item.data.category.charAt(0).toUpperCase() + item.data.category.slice(1)}
                </span>
                <h3 class="font-heading text-cream-50 text-lg font-medium">{item.data.title}</h3>
                {item.data.location && (
                  <p class="text-cream-300 text-sm mt-1">{item.data.location}</p>
                )}
              </div>
            </div>
            <a 
              href={imgSrc} 
              class="glightbox absolute inset-0" 
              data-gallery="gallery"
              data-title={item.data.title}
              data-description={item.data.description || ''}
              aria-label={`View ${item.data.title} in full size`}
            ></a>
          </article>
        );
      })}
    </div>

    {allImages.length === 0 && (
      <div class="text-center py-20">
        <svg class="w-16 h-16 mx-auto text-cream-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <p class="text-cream-600">No images yet. Add items to <code>src/content/gallery/</code> to populate the gallery.</p>
      </div>
    )}
  </div>
</section>

<script is:inline>
  const categoryBtns = document.querySelectorAll('.category-btn');
  const galleryItems = document.querySelectorAll('.gallery-item');

  categoryBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const category = btn.dataset.category;
      
      categoryBtns.forEach(b => {
        b.classList.remove('bg-terracotta-100', 'text-terracotta-700', 'aria-selected');
        b.classList.add('bg-cream-100', 'text-cream-700');
        b.setAttribute('aria-selected', 'false');
      });
      
      btn.classList.remove('bg-cream-100', 'text-cream-700');
      btn.classList.add('bg-terracotta-100', 'text-terracotta-700');
      btn.setAttribute('aria-selected', 'true');

      galleryItems.forEach(item => {
        const itemCategory = item.dataset.category;
        if (category === 'all' || itemCategory === category) {
          item.style.display = 'block';
          item.style.animation = 'fadeIn 0.3s ease-out forwards';
        } else {
          item.style.display = 'none';
        }
      });
    });
  });
</script>

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 1rem;
  }
  
  @media (min-width: 640px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (min-width: 1024px) {
    .gallery-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  
  @media (min-width: 1280px) {
    .gallery-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .gallery-item {
    position: relative;
    border-radius: 1rem;
    overflow: hidden;
    aspect-ratio: 4/5;
  }
  
  @media (min-width: 768px) {
    .gallery-item {
      aspect-ratio: 3/4;
    }
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .gallery-item:hover img {
    transform: scale(1.05);
  }

  .gallery-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(124 45 18 / 0.8), rgb(124 45 18 / 0.2), transparent);
    opacity: 0;
    transition: opacity 0.3s ease;
    display: flex;
    align-items: flex-end;
    padding: 1rem;
  }

  .gallery-item:hover .gallery-overlay {
    opacity: 1;
  }
</style>