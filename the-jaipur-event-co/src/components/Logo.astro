---
import { Image } from 'astro:assets';
import logoImage from '../assets/logo.png';

interface Props {
  class?: string;
  width?: number;
  height?: number;
  showText?: boolean;
  alt?: string;
}
const { 
  class: className = '', 
  width = 40, 
  height = 40, 
  showText = false,
  alt = 'The Jaipur Event Co'
} = Astro.props;
---

<span class={`inline-flex items-center gap-2 ${className}`} aria-label="The Jaipur Event Co - Home">
  <Image 
    src={logoImage} 
    alt={alt}
    width={width}
    height={height}
    class="object-contain"
    loading="eager"
  />
  
  {showText && (
    <span class="font-heading font-medium text-terracotta-900 text-xl hidden sm:inline">The Jaipur Event Co</span>
  )}
</span>