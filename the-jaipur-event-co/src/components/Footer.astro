      <div>
        <h3 class="font-heading text-lg font-medium text-gold-300 mb-4">Quick Links</h3>
        <nav aria-label="Footer navigation">
          <ul class="space-y-2">
            <li><a href="/" class="text-cream-300 hover:text-gold-300 transition-colors text-sm">Home</a></li>
            <li><a href="#about" class="text-cream-300 hover:text-gold-300 transition-colors text-sm">About Us</a></li>
            <li><a href="#services" class="text-cream-300 hover:text-gold-300 transition-colors text-sm">Services</a></li>
            <li><a href="#gallery" class="text-cream-300 hover:text-gold-300 transition-colors text-sm">Gallery</a></li>
            <li><a href="#contact" class="text-cream-300 hover:text-gold-300 transition-colors text-sm">Contact</a></li>
          </ul>
        </nav>
      </div>

      <div>
        <h3 class="font-heading text-lg font-medium text-gold-300 mb-4">Services</h3>
        <ul class="space-y-2">
          <li><a href="#services" class="text-cream-300 hover:text-gold-300 transition-colors text-sm">Wedding Design & Management</a></li>
          <li><a href="#services" class="text-cream-300 hover:text-gold-300 transition-colors text-sm">Corporate & Brand Events</a></li>
          <li><a href="#services" class="text-cream-300 hover:text-gold-300 transition-colors text-sm">Cultural Celebrations</a></li>
          <li><a href="#services" class="text-cream-300 hover:text-gold-300 transition-colors text-sm">Decor & Styling</a></li>
        </ul>
      </div>

      <div>
        <h3 class="font-heading text-lg font-medium text-gold-300 mb-4">Contact Us</h3>
        <address class="not-italic text-cream-300 text-sm space-y-2">
          <p>Jaipur, Rajasthan</p>
          <p><a href="tel:+91XXXXXXXXXX" class="hover:text-gold-300 transition-colors">+91 XXXXX XXXXX</a></p>
          <p><a href="mailto:hello@thejaipureventco.com" class="hover:text-gold-300 transition-colors">hello@thejaipureventco.com</a></p>
          <p><a href="https://wa.me/91XXXXXXXXXX" target="_blank" rel="noopener noreferrer" class="hover:text-gold-300 transition-colors">WhatsApp Us</a></p>
        </address>
      </div>
    </div>

    <div class="border-t border-terracotta-800 pt-8 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-cream-400 text-sm">&copy; {currentYear} The Jaipur Event Co. All rights reserved.</p>
      <p class="text-cream-500 text-sm">Designed & Developed with <span class="text-maroon-400">♥</span> by <a href="#" class="hover:text-gold-300 transition-colors">Your Studio Name</a></p>
    </div>
  </div>
</footer>