    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
      <div class="lg:col-span-1">
        <a href="/" class="flex items-center gap-2 mb-4" aria-label="The Jaipur Event Co - Home">
          <span class="text-2xl md:text-3xl font-heading font-medium text-gold-300">The Jaipur Event Co</span>
        </a>
        <p class="text-cream-300 text-sm leading-relaxed mb-6">Crafting timeless celebrations in the Pink City. Where heritage meets celebration.</p>
        <div class="flex items-center gap-4">
          <a href="https://instagram.com/thejaipureventco" target="_blank" rel="noopener noreferrer" class="text-cream-300 hover:text-gold-300 transition-colors" aria-label="Follow us on Instagram">
