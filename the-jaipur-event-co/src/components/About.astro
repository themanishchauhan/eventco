---
interface Props {
  title?: string;
  subtitle?: string;
  paragraphs?: string[];
  accentImages?: string[];
}
const { 
  title = 'Where Heritage Meets Celebration',
  subtitle = 'Our Philosophy',
  paragraphs = [
    'At The Jaipur Event Co, we believe every celebration tells a story. Rooted in the royal heritage of the Pink City, we blend traditional Rajasthani craftsmanship with contemporary design sensibilities to create events that are as unique as the people they honor.',
    'From intimate gatherings at heritage havelis to grand celebrations at iconic palaces, our team curates every detail with precision — hand-selected florals, bespoke decor, artisan-crafted mandaps, and seamless coordination. We work with Jaipur\'s finest local artisans, florists, and vendors to bring your vision to life.',
    'Our approach is personal, not packaged. We take the time to understand your story, your culture, and your dreams — then translate them into moments that linger in memory long after the last guest departs.'
  ],
  accentImages = []
} = Astro.props;
---

<section id="about" class="section bg-white" aria-labelledby="about-title">
  <div class="container-custom">
    <div class="max-w-3xl mx-auto text-center mb-16">
      <span class="inline-block px-3 py-1 rounded-full bg-terracotta-100 text-terracotta-700 text-sm font-medium mb-4">Our Story</span>
      <h2 id="about-title" class="section-title">{title}</h2>
      <p class="section-subtitle mx-auto">{subtitle}</p>
    </div>

    <div class="grid md:grid-cols-2 gap-12 items-start">
      <div class="space-y-6 text-cream-700 leading-relaxed">
        {paragraphs.map((p, i) => (
          <p class="animate-slide-up" style={`animation-delay: ${i * 100}ms`}>{p}</p>
        ))}
      </div>

      <div class="relative">
        <div class="aspect-[4/5] rounded-2xl overflow-hidden bg-cream-100 relative">
          {accentImages[0] ? (
            <Image src={accentImages[0]} alt="Our team crafting event details" class="w-full h-full object-cover" />
          ) : (
            <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-terracotta-100 to-gold-100">
              <svg class="w-24 h-24 text-terracotta-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
          )}
        </div>
        
        {accentImages[1] && (
          <div class="absolute -bottom-6 -left-6 md:-bottom-8 md:-left-8 aspect-square md:aspect-[3/4] rounded-2xl overflow-hidden bg-cream-100 shadow-2xl" style={{ maxWidth: '200px' }}>
            <Image src={accentImages[1]} alt="Event decor detail" class="w-full h-full object-cover" />
          </div>
        )}
      </div>
    </div>
  </div>
</section>